{
    "name": "chani/safi-auth",
    "description": "Authentication, Session Management & BruteForce Shield Extension for Safi Framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jean Bruenn",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "chani/safi-core": "^0.1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Safi\\Extensions\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Safi\\Extensions\\Auth\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
