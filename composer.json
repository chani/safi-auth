{
    "name": "chani/safi-auth",
    "type": "library",
    "description": "Auth Extension for Safi Microframework",
    "license": "proprietary",
    "repositories": [
        { "type": "path", "url": "../safi-core" },
        { "type": "path", "url": "../safi-db-redbean" },
        { "type": "path", "url": "../safi-session" }
    ],
    "require": {
        "php": "^8.5",
        "chani/safi-core": "^0.1.0",
        "chani/safi-db-redbean": "^0.1.0",
        "chani/safi-session": "^0.1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": { "Safi\\Extensions\\Auth\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Safi\\Extensions\\Auth\\Tests\\": "tests/" }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
