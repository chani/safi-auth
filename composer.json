{
  "name": "chani/safi-auth",
  "type": "library",
  "description": "Auth Extension for Safi Microframework",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "chani/safi-core": "^0.1.18",
    "chani/safi-session": "^0.1.5",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "chani/safi-db-redbean": "^0.1.11"
  },
  "autoload": {
    "psr-4": {
      "Safi\\Extensions\\Auth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Safi\\Extensions\\Auth\\Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../safi-*"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  }
}
